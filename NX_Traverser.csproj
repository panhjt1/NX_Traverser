<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>Library</OutputType>
    <AssemblyName>NX_Traverser</AssemblyName>
    <RootNamespace>NX_Traverser</RootNamespace>
    <!-- NX 2512's documented Framework baseline is 4.8. Allow an explicit
         4.7.2 compatibility build for existing projects; NX references still
         have to satisfy MSBuild's target-framework checks. -->
    <TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == ''">v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\$(TargetFrameworkVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFrameworkVersion)\</IntermediateOutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <NXInstallDir Condition="'$(NXInstallDir)' == ''">$(UGII_BASE_DIR)</NXInstallDir>
    <NXManagedDir>$(NXInstallDir)\NXBIN\managed</NXManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="NXOpen">
      <HintPath>$(NXManagedDir)\NXOpen.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NXManagedDir)\NXOpen.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NXOpenUI">
      <HintPath>$(NXManagedDir)\NXOpenUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(NXManagedDir)\NXOpen.UF.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="*.cs" />
    <EmbeddedResource Include="$(NXInstallDir)\UGOPEN\NXSigningResource.res">
      <LogicalName>NXSigningResource.res</LogicalName>
    </EmbeddedResource>
    <None Include="ClassLibrary1.dlx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="ValidateNXInstallation" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(TargetFrameworkVersion)' != 'v4.8' And '$(TargetFrameworkVersion)' != 'v4.7.2'" Text="本项目只提供 v4.8 和 v4.7.2 编译配置。" />
    <Error Condition="!Exists('$(NXManagedDir)\NXOpen.dll')" Text="指定 NX 2512 安装目录: /p:NXInstallDir=...；需要 NXBIN\managed\NXOpen.dll。" />
    <Error Condition="!Exists('$(NXManagedDir)\NXOpen.Utilities.dll') Or !Exists('$(NXManagedDir)\NXOpenUI.dll') Or !Exists('$(NXManagedDir)\NXOpen.UF.dll')" Text="NX 2512 managed 引用不完整，需要 NXOpen.Utilities.dll、NXOpenUI.dll 和 NXOpen.UF.dll。请安装对应 NX Open 开发组件。" />
    <Error Condition="!Exists('$(NXInstallDir)\UGOPEN\NXSigningResource.res')" Text="缺少 NX 签名资源 UGOPEN\NXSigningResource.res；请安装对应 NX Open 开发组件。" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
